{
  "name": "codual-ui-site",
  "version": "0.0.0",
  "private": true,
  "description": "The Codual UI docs site.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check-names": "node --no-warnings scripts/check-names.ts",
    "test": "node --no-warnings --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "npm run check-names && next build"
  },
  "dependencies": {
    "fumadocs-core": "16.17.10",
    "fumadocs-ui": "16.17.10",
    "next": "16.4.4",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  }
}
