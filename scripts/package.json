{
  "name": "codual-ui-scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Repository checks for Codual UI.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "spec-coverage": "node src/main.ts ..",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm spec-coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.15.0"
}
