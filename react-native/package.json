{
  "name": "@codual-ai/react-native-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Look-free behaviours for React Native apps, the same as Codual UI's SwiftUI package, built for coding agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codual-ai/ui.git",
    "directory": "react-native"
  },
  "homepage": "https://github.com/codual-ai/ui#readme",
  "bugs": "https://github.com/codual-ai/ui/issues",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.78"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "jest": "29.7.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.15.0"
}
